{
  "name": "quaera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Мобильный тренажёр аналитика данных: SQL, модель данных, pandas, доменные метрики FMCG/pharma",
  "author": "Stanislav Sidorovich (https://www.linkedin.com/in/stanislavsidorovich)",
  "license": "Apache-2.0",
  "homepage": "https://quaera.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/StanislavSidorovich/Quaera"
  },
  "bugs": {
    "url": "https://github.com/StanislavSidorovich/Quaera/issues"
  },
  "scripts": {
    "sync:sqljs": "node scripts/sync-sqljs.mjs",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "gen:data": "node scripts/build-dataset.mjs",
    "verify:data": "node scripts/verify-dataset.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "test:scheduler": "node scripts/test-scheduler.mjs",
    "test:merge": "node scripts/test-merge.mjs",
    "test:chart": "node scripts/test-chart-spec.mjs",
    "test:schema-layout": "node scripts/test-schema-layout.mjs",
    "test:prose-en": "node scripts/test-prose-en.mjs",
    "test:text-grade": "node scripts/test-text-grade.mjs",
    "test:storage-migration": "node scripts/test-storage-migration.mjs",
    "test:grade-compare": "node scripts/test-grade-compare.mjs",
    "test:push-schedule": "node scripts/test-push-schedule.mjs",
    "test:css-width": "node scripts/test-css-width.mjs",
    "test:story-line": "node scripts/test-story-line.mjs",
    "verify": "npm run verify:data && npm run verify:content && npm run test:scheduler && npm run test:merge && npm run test:chart && npm run test:schema-layout && npm run test:prose-en && npm run test:text-grade && npm run test:storage-migration && npm run test:grade-compare && npm run test:push-schedule && npm run test:css-width && npm run test:story-line",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prepare:assets": "npm run sync:sqljs && npm run sync:pyodide && npm run gen:icons && npm run gen:data",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild-sw.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pyodide": "^0.26.4",
    "sql.js": "^1.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
