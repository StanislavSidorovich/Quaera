{
  "name": "querium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Мобильный тренажёр аналитика данных: SQL, модель данных, pandas, доменные метрики FMCG/pharma",
  "scripts": {
    "sync:sqljs": "node scripts/sync-sqljs.mjs",
    "gen:data": "node scripts/build-dataset.mjs",
    "verify:data": "node scripts/verify-dataset.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify": "npm run verify:data && npm run verify:content",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prepare:assets": "npm run sync:sqljs && npm run gen:icons && npm run gen:data",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sql.js": "^1.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
