# Политика кеширования для Cloudflare Pages.
#
# Приложение офлайновое, и почти весь его вес — неизменяемые файлы: датасет,
# рантайм SQLite, собранные бандлы с хешем в имени. Их кешируем максимально долго.
# Точки входа (index.html и service worker) — наоборот, никогда: иначе обновление
# приложения не доедет до устройства, на котором оно уже установлено.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sqljs/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

# Датасет и схема — единственные файлы проекта с постоянным адресом
# и меняющимся содержимым. У бандлов свежесть подтверждена именем, здесь —
# только вопросом к серверу, поэтому no-cache: браузер обязан спросить.
#
# Неделя (max-age=604800) стояла здесь до 2026-08-12 и стоила ровно того,
# от чего берегла: после переезда датасета на латиницу Chrome ещё неделю
# отдавал старые названия брендов из своего HTTP-кеша — при том что
# и сайт, и репозиторий были правильные, а в инкогнито всё сходилось.
# Service worker это не спасало: он ходил в сеть, а сеть отвечала из того же
# HTTP-кеша, ничего не спрашивая.
#
# Трафика это почти не стоит. Датасет лежит в кеше service worker'а, и в сеть
# запрос уходит только когда тот кеш пуст, то есть раз на сборку; при живом
# ETag ответом будет 304 в несколько сотен байт, а не 3.5 МБ.
/data/*
  Cache-Control: no-cache

# Service worker обязан проверяться при каждом запуске: он управляет всем
# остальным кешем, и застрявшая старая версия замораживает приложение целиком.
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
